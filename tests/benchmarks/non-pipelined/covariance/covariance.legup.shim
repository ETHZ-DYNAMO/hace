func.func @lpm_divide(%a : i32, %b : i32) -> (i32) {
	%r = arith.divsi %a, %b : i32
	func.return %r : i32
}

func.func @covariance(%data : !llvm.ptr, %symmat : !llvm.ptr, %mean : !llvm.ptr) -> () {
	%c0 = arith.constant 0 : i32
	func.call @HACE.covariance(%c0, %c0, %c0, %data, %mean, %symmat) : (i32, i32, i32, !llvm.ptr, !llvm.ptr, !llvm.ptr) -> ()
	func.return
}
